# DeepSeek API Key (从 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ApiNebula 中转站配置 (从 https://apinebula.ai/zh/console 个人中心获取)
# BASE_URL: 站点地址（不含 /v1）
# TOKEN: 系统令牌（个人中心生成，非 API Key）
# USER_ID: 用户 ID（个人中心查看）
APINEBULA_BASE_URL=https://apinebula.ai
APINEBULA_TOKEN=your-system-token
APINEBULA_USER_ID=your-user-id
